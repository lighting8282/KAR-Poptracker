# Third-party builder tool (separate repo)
poptracker-pack-builder/

# Game data files (not part of the tracker pack)
*.h4m
*.dat
*.7z
*.dol
*.iso
*.gcm
*.rvz
*.tpl
*.brres

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python dev scripts (not needed to run the tracker)
*.py
__pycache__/
*.pyc

# Other game/dev files
*.ini
*.bnr
opening.bnr
datapackage_url.json

# Audio files
audio/

# Source/reference art is tracked on purpose: images/Events, images/Misc Icons and
# images/Stadiums hold the originals the shipped icons were cut from, and existed on
# one machine only. They are not referenced by the pack and are excluded from the
# release zip by the build's explicit file list, so tracking them costs nothing at
# runtime. The one thing still kept out is the 27 MB GKY.7z texture dump, via *.7z
# above - it is redundant with the extracted stadium images beside it.

# Old/backup icon versions
images/items/*(old)*

# Dev preview/test screenshots at root
bottom_section_preview.png
drag_race_1_preview.png
test*/
/GameCube*.png
/GameCube*.PNG
test*.PNG
test*.png
